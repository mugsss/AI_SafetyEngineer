# SafetyGuard Root Environment Configuration
# These variables are used by Vercel for deployment

# Database - Neon PostgreSQL (auto-populated by Vercel Neon integration)
# DATABASE_URL is set automatically

# Redis - Upstash (auto-populated by Vercel Upstash integration)
# REDIS_URL is set automatically
# KV_URL is set automatically
# KV_REST_API_URL is set automatically
# KV_REST_API_TOKEN is set automatically

# LLM Configuration
FEATHERLESS_API_BASE=https://api.featherless.ai/v1
LLM_MODEL=Qwen/Qwen3-32B

# Frontend URLs - Update for production
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=200
