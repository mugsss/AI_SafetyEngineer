# Copy to safetyguard/.env (backend loads this file even if you start uvicorn from safetyguard/backend/)
# Frontend: also copy NEXT_PUBLIC_* lines to safetyguard/frontend/.env.local or use frontend/.env.example

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Optional: n8n Cloud / self-hosted UI (for “Open n8n” / “View executions” in Settings)
# NEXT_PUBLIC_N8N_APP_URL=https://yourname.app.n8n.cloud

# Backend
DATABASE_URL=sqlite:///./safetyguard.db
REDIS_URL=redis://localhost:6379/0

# --- LLM (pick one provider; OpenAI is checked first) ---
#
# Option A — OpenAI (or any OpenAI-compatible HTTP API)
# OPENAI_API_KEY=sk-...
# Optional: Azure / local gateway — omit for https://api.openai.com/v1
# OPENAI_BASE_URL=
# Optional: model when using OpenAI (defaults to gpt-4o-mini if LLM_MODEL looks like a Featherless id)
# OPENAI_MODEL=gpt-4o-mini
#
# Option B — Featherless AI (open-source models)
# Get a key at https://featherless.ai/account/api-keys
# FEATHERLESS_API_KEY=...
# FEATHERLESS_API_BASE=https://api.featherless.ai/v1
# LLM_MODEL=Qwen/Qwen3-32B
#
# Mock / offline: no real LLM (deterministic mock analysis, static-only agents)
FEATHERLESS_API_KEY=mock

# Optional: n8n workflow automation (Webhook node URL)
# When set, SafetyGuard POSTs JSON on analysis.completed / analysis.failed
# N8N_WEBHOOK_SECRET=optional_shared_secret_for_X-SafetyGuard-Signature_header
# N8N_WEBHOOK_URL=
# FRONTEND_BASE_URL=http://localhost:3000
#
# n8n Public API (Settings → n8n API in n8n) — for /api/v1/workflows health checks
# N8N_BASE_URL=https://yourname.app.n8n.cloud
# N8N_API_KEY=

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=200
