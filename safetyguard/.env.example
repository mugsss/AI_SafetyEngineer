# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Backend
DATABASE_URL=sqlite:///./safetyguard.db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=your-secret-key-min-32-chars-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# LLM (Featherless AI – open-source models)
# Get your API key at https://featherless.ai/account/api-keys
# Set FEATHERLESS_API_KEY=mock to use deterministic mock data (no LLM calls)
FEATHERLESS_API_KEY=mock
FEATHERLESS_API_BASE=https://api.featherless.ai/v1
LLM_MODEL=Qwen/Qwen3-32B

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=200
