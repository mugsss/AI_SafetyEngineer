# Copy to .env.local (Next.js reads .env.local automatically)
# Parent folder safetyguard/.env is for the Python backend only — Next does not load it.

# Optional: if unset, the browser calls /api/* on this dev server and next.config.mjs proxies
# to http://127.0.0.1:8000 (avoids 404 when axios accidentally hit port 3000 without a route).
# If set, axios talks to this origin directly. Restart `npm run dev` after editing.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Socket.IO client URL (http(s); not proxied through Next).
NEXT_PUBLIC_WS_URL=http://127.0.0.1:8000

# Optional: same host as n8n (Settings → “Open n8n” links). Example: https://you.app.n8n.cloud
# NEXT_PUBLIC_N8N_APP_URL=
